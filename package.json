{
  "name": "pi-optchat",
  "version": "0.8.4",
  "type": "module",
  "pi": {
    "extensions": [
      "./src/index.ts"
    ],
    "skills": [
      "./skills"
    ],
    "image": "https://raw.githubusercontent.com/jonaslsaa/pi-optchat/main/docs/banner.jpg"
  },
  "scripts": {
    "check": "npm run lint:comments && tsc --noEmit",
    "lint:comments": "node scripts/lint-comments.mjs",
    "verify": "node scripts/verify.mjs",
    "test": "node scripts/verify.mjs --test-only",
    "test:one": "node --experimental-transform-types --no-warnings --import ./test/support.ts --test",
    "test:pi-compat": "node --import tsx --test test/pi-runtime-compat.test.mjs",
    "quota:report": "node --experimental-transform-types --no-warnings scripts/quota-report.mjs",
    "debug:capture": "node scripts/debug-capture.mjs",
    "measure:foreign-ids": "node --experimental-transform-types scripts/foreign-id-rate.mjs",
    "test:live": "tsx test/live.ts",
    "benchmark:agents": "tsx test/agent-benchmark.ts",
    "benchmark:context": "tsx --import ./test/support.ts test/context-benchmark.ts",
    "benchmark:resolution": "tsx --import ./test/support.ts test/resolution-benchmark.ts",
    "benchmark:performance": "tsx test/performance-benchmark.ts",
    "test:reliability": "tsx --import ./test/support.ts --test test/reliability-performance.test.ts test/operations.test.ts test/operation-diagnostics.test.ts test/output-context.test.ts test/performance-lazy.test.ts",
    "benchmark:reliability": "tsx test/reliability-benchmark.ts",
    "benchmark:summaries": "tsx test/summary-ab-benchmark.ts",
    "bench:gate": "node --experimental-transform-types --no-warnings scripts/bench-gate.ts",
    "manifest": "node scripts/change-manifest.mjs",
    "replay": "node --experimental-transform-types --no-warnings scripts/gate-replay.mjs --rules",
    "corrections": "node --experimental-transform-types --no-warnings scripts/correction-scan.mjs"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "1.2.0",
    "@earendil-works/pi-ai": "1.2.0",
    "@earendil-works/pi-coding-agent": "1.2.0",
    "@earendil-works/pi-tui": "1.2.0",
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typebox": "1.3.27",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "overrides": {
    "undici": "^8.12.2"
  },
  "description": "An always-on engineering agent for Pi: endless zoomable memory, Slack, CI wakes, a crew of workers across accounts, and guarded deploys.",
  "keywords": [
    "pi-package",
    "pi-extension",
    "optchat",
    "uniichat",
    "memory",
    "subagents"
  ],
  "author": "Jonas",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jonaslsaa/pi-optchat.git"
  },
  "homepage": "https://github.com/jonaslsaa/pi-optchat#readme",
  "bugs": {
    "url": "https://github.com/jonaslsaa/pi-optchat/issues"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "src",
    "scripts/scoreboard.mjs",
    "scripts/cost-report.mjs",
    "assistant/src",
    "assistant/scripts",
    "assistant/web/index.html",
    "assistant/web/src",
    "assistant/package.json",
    "assistant/README.md",
    "skills",
    "docs/*.md",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ]
}
