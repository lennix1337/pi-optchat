{
    "display_information": { "name": "OptChat", "description": "Assistente pessoal local do Lucas (OptChat)" },
    "features": {
        "app_home": { "home_tab_enabled": true, "messages_tab_enabled": true, "messages_tab_read_only_enabled": false, "agent_tasks_enabled": true },
        "bot_user": { "display_name": "OptChat", "always_online": false },
        "shortcuts": [ { "name": "Mandar pro Jarvis", "type": "message", "callback_id": "optchat_forward", "description": "Envia esta mensagem para o Jarvis na DM" } ]
    },
    "oauth_config": {
        "scopes": { "bot": ["im:history", "im:read", "im:write", "chat:write", "channels:read", "channels:history", "channels:manage", "channels:join", "groups:read", "groups:history", "groups:write", "users:read", "reactions:write", "files:read", "commands"] },
        "pkce_enabled": false
    },
    "settings": {
        "event_subscriptions": { "bot_events": ["message.im", "message.channels", "message.groups"] },
        "interactivity": { "is_enabled": true },
        "org_deploy_enabled": false,
        "socket_mode_enabled": true,
        "is_mcp_enabled": false,
        "token_rotation_enabled": false,
        "app_level_token_rotation_enabled": false
    }
}
